<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WC4MapEditor</RootNamespace>
    <AssemblyName>WC4MapEditor</AssemblyName>
    <EnableHWAcceleration>true</EnableHWAcceleration>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>NU1701</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resource\Texture\ZSEditor_Icon\name.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      原生库不内嵌到单文件里。若设为 true，程序每次启动都要把原生库
      （libSkiaSharp / wpfgfx_cor3 / PresentationNative_cor3 等）解压到
      %TEMP%\.net\<app>\<hash>\；该目录不可写（杀软拦截、权限、磁盘空间）时
      会直接失败，报 "I/O failure when writing extracted files"。
      放在 exe 同目录最稳，也不需要任何解压。
    -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
          <Nullable>enable</Nullable>
          <ImplicitUsings>enable</ImplicitUsings>
       </PropertyGroup>

        <!-- 让 Debug.WriteLine 等调试信息在 Release / publish 之后仍保留，并输出到控制台 -->
       <PropertyGroup Condition="'$(Configuration)' == 'Release'">
          <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
       </PropertyGroup>

  <ItemGroup>
    <!-- 子项目统一放在 src/ 下，这里把它们的源码排除出宿主项目 -->
    <Compile Remove="src\**\*.cs" />
    <Page Remove="src\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 组合根（App.xaml.cs）只用到 DI 容器；MVVM / SkiaSharp.Views 已随界面代码移到 GUI 项目 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\WC4MapEditor.Core\WC4MapEditor.Core.csproj" />
    <ProjectReference Include="src\WC4MapEditor.Rendering\WC4MapEditor.Rendering.csproj" />
    <ProjectReference Include="src\WC4MapEditor.GUI\WC4MapEditor.GUI.csproj" />
    <ProjectReference Include="src\WC4MapEditor.Mcp\WC4MapEditor.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lua 示例脚本随程序输出，方便用 lua scripts/lua-example.lua 直接试 -->
    <None Update="scripts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>