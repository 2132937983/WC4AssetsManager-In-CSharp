# 忽略所有文件
*

# 允许所有文件夹（让子目录中的文件能被匹配）
!*/

# 允许代码文件
!*.cs

# 允许XAML文件
!*.xaml

# 允许TXT文件
!*.txt

# 允许项目/解决方案文件
!*.sln
!*.csproj

# 允许JSON配置文件
!*.json

# 允许XML配置文件
!*.xml

# 允许INI配置文件
!*.ini

# 允许MD文档
!*.md

# 允许.gitignore本身
!.gitignore

# 忽略bin和obj（编译输出）
[Bb]in/
[Oo]bj/

# 忽略Cache文件夹
[Cc]ache/
[Cc]aches/

# 忽略音乐文件
*.mp3
*.wav
*.ogg
*.flac

# 忽略图片资源
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.svg
*.ico
*.tiff

# 忽略IDE配置
.vs/
.vscode/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# 忽略OS文件
.DS_Store
Thumbs.db
desktop.ini

# 忽略编译输出
*.dll
*.exe
*.pdb
*.cache
*.log