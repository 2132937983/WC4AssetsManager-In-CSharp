# ==================== 构建产物 ====================
**/bin/
**/obj/
publish/
build/
dist/
dist_small/
source/
Cache/
TestResults/

# ==================== IDE / 用户级文件 ====================
.vs/
.idea/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# ==================== 运行期产物 ====================
# 程序崩溃日志写在 <输出目录>/Logs
Logs/
*.log

# ==================== Python ====================
__pycache__/
*.py[cod]

# ==================== 外部工具 ====================
.codeartsdoer/
.kilo/

# ==================== 参考资料 ====================
Reference/

# ==================== 游戏资源 ====================
# Resource 下绝大多数素材不进仓库，只放开下列子目录。
Resource/*
!Resource/Texture/
!Resource/Config/
!Resource/Memory/
!Resource/Lang/
!Resource/Geo/

# 大块数据与外部工具可执行文件，任何层级都排除
**/WC4DATA
**/Lib/*.exe

# ==================== AI / 工具运行期产物 ====================
# AI 助手配置（含 ApiKey，程序写在 exe 同目录；exe 若放在仓库根目录也不会被提交）
ai_settings.json
# 编辑器 / AI 截图（默认落在 exe 同目录的 screenshots/）
screenshots/
# write_file 等工具的自动备份
*.bak
# 旧 Lua 工具脚本（scripts/读取军团工具.lua）导出的军团表
scripts/legion-map.txt

# GeoNames 中国全量原始数据过大；上海 spec 已固化 240 城，不提交原始 CN
Resource/Geo/CN/
Resource/Geo/CN.zip

