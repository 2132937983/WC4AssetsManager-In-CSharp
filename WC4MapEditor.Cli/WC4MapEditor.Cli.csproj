<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WC4MapEditor.Cli</RootNamespace>
    <AssemblyName>WC4MapEditor.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wc4me</ToolCommandName>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25277.114" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WC4MapEditor.Core\WC4MapEditor.Core.csproj" />
    <ProjectReference Include="..\WC4MapEditor.Rendering\WC4MapEditor.Rendering.csproj" />
  </ItemGroup>

</Project>
